{
  "name": "komari-theme-stock",
  "private": true,
  "version": "0.4.0",
  "description": "A stock-terminal style theme for Komari Monitor",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/check-locales.mjs && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "package": "npm run build && node scripts/package-theme.mjs",
    "dev:mock": "vite --mode mock",
    "i18n:check": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-query": "^5.108.4",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "filesize": "^11.0.35",
    "flag-icons": "^7.6.0",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-resources-to-backend": "^1.3.0",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "dotted-map": "^3.1.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "world-countries": "^5.1.0"
  }
}
